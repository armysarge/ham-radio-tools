{
  "name": "ham-radio-tools",
  "version": "0.3.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:demo": "vue-tsc --noEmit && vite build --mode demo --outDir dist-demo",
    "preview": "vite preview",
    "test": "vitest run",
    "check:offline": "node scripts/check-offline.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "preversion": "npm test",
    "check:sources": "node scripts/check-sources.mjs",
    "build:packs": "node scripts/build-packs.mjs",
    "desktop": "npm run build && electron .",
    "desktop:unpacked": "npm run build && electron-builder --dir --publish never",
    "desktop:dist": "npm run build && electron-builder --publish never",
    "check:desktop": "npm run build && node scripts/check-desktop.mjs",
    "report:desktop": "node scripts/desktop-report.mjs"
  },
  "dependencies": {
    "satellite.js": "^6.0.1",
    "topojson-client": "^3.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "electron": "^44.9.1",
    "electron-builder": "26.15.3",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "author": "ZS6SHZ",
  "description": "Offline-first amateur radio workbench: RF calculators, antenna designers, grid squares, CW and reference tools.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armysarge/ham-radio-tools.git"
  },
  "homepage": "https://github.com/armysarge/ham-radio-tools#readme"
}
